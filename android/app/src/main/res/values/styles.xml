<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the Flutter engine starts: brand green with the app logo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/brand_green</item>
        <item name="android:navigationBarColor">@color/brand_green</item>
    </style>
    <!-- Applied after the first frame; Flutter paints everything from here on. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
