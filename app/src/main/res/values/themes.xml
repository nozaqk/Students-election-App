<resources>
    <!-- Shown while the app starts and, via MainActivity, until the website has finished loading. -->
    <style name="Theme.ElectionVote.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0B3D2E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ElectionVote</item>
    </style>
    <style name="Theme.ElectionVote" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">#0B3D2E</item>
        <item name="android:navigationBarColor">#0B3D2E</item>
        <item name="android:windowBackground">#0B3D2E</item>
    </style>
</resources>
